# See https://nextjs.org/docs/app/building-your-application/configuring/typescript
# for more information about tsconfig.json and .gitignore behavior

# dependencies
/node_modules

# build output
/out
/build

# production bundles
/.next

# used for debugging setups
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env*.local

# cache directories
.cache
/.parcel-cache

# ide
.idea
.vscode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.vscode/* # prevent nested IDE configs

# misc
.DS_Store
*.pem
.eclipsesettings/

# the following files are no longer used since Next.js 13
# /pages
# /styles
# /public/styles.css
